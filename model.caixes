.explicacio h2{
    margen superior: 0;
}

.texto-demostracio{
    ancho máximo: 650píxeles;
    margen: 0auto;
}

.escenariori{
    ancho máximo: 520píxeles;
    margen: 28píxelesauto0;
    rebosar:oculto;
    radio de borde: 12píxeles;
    color de fondo: #dff1df;
    imagen de fondo: gradiente radial(#a5cfa8 1píxeles,transparente1píxeles);
    tamaño de fondo: 16píxeles 16píxeles;
}

.etiqueta-marge{
    margen: 12píxeles 0 -20píxeles;
    color: #286343;
    tamaño de fuente: 0,78movimiento rápido del ojo;
    peso de fuente: 700;
    espaciado entre letras: 0,08ellos;
    alineación de texto:centro;
}

.caixa{
    ancho: min(300píxeles, cálculo(100% - 144píxeles));
    margen: 32píxelesauto;
    relleno: 24píxeles;
    borde: 8píxelessólido#e8a84a;
    fondo: #ffe7b8;
}

.relleno de etiquetas{
    margen: 0 0 10píxeles;
    color: #76501a;
    tamaño de fuente: 0,75movimiento rápido del ojo;
    peso de fuente: 700;
    espaciado entre letras: 0,08ellos;
    alineación de texto:centro;
}

.contingu{
    mostrar:doblar;
    altura mínima: 120píxeles;
    dirección de flexión:columna;
    alinear elementos:centro;
    justificar-contenido:centro;
    color: #fff;
    fondo: #287d70;
    alineación de texto:centro;
}

.contingu durar{
    color: #c6efe3;
    tamaño de fuente: 0,75movimiento rápido del ojo;
    peso de fuente: 700;
    espaciado entre letras: 0,12ellos;
}

.contingu fuerte{
    tamaño de fuente: 1.6movimiento rápido del ojo;
}

.contingu pequeño{
    color: #e0f3ed;
}

.explicacio{
    margen superior: 24píxeles;
}

.regiones{
    mostrar:red;
    columnas de plantilla de cuadrícula: repetir(ajuste automático, mínimo máximo(180píxeles, 1fr));
    brecha: 12píxeles;
    margen: 0;
}

.regiones div{
    relleno: 16píxeles;
    radio de borde: 10píxeles;
    fondo: #f1f6f1;
}

.regiones dt{
    color: #17634f;
    peso de fuente: 700;
}

.regiones dd{
    margen: 4píxeles 0 0;
}

.fórmula{
    margen: 20píxeles 0 0;
}

.fórmula código{
    relleno: 3píxeles 6píxeles;
    radio de borde: 4píxeles;
    fondo: #edf3ee;
}

@medios de comunicación(ancho máximo: 520píxeles) {
    principal{
        ancho: cálculo(100% - 24píxeles);
        margen: 24píxelesauto;
    }

    .demostración,
    .explicacio{
        relleno: 20píxeles;
    }
}